---
import { toTaxonomySlug, type PostCardData } from '../utils/taxonomy';

interface Props {
	posts: PostCardData[];
}

const { posts } = Astro.props;
const tones = {
	sky: 'from-[#b9efff] to-[#d9d4ff] dark:from-[#1a4053] dark:to-[#312a62]',
	sunset: 'from-[#ffe0ed] to-[#ffe9ba] dark:from-[#4c2643] dark:to-[#4a3824]',
	mint: 'from-[#d5f7e4] to-[#fff3af] dark:from-[#1e453c] dark:to-[#484022]',
};
---

{posts.length ? <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
	{posts.map((post) => <article class="group anime-shadow relative flex min-h-[380px] flex-col overflow-hidden rounded-2xl border-2 border-sky-ink bg-white transition duration-300 hover:-translate-y-2 dark:border-white/20 dark:bg-[#181d3a]">
		<div class={`relative h-44 overflow-hidden bg-linear-to-br ${tones[post.coverTone]}`}>
			{post.coverImage ? <img src={post.coverImage} alt="" class="absolute inset-0 size-full object-cover transition duration-700 group-hover:scale-105" loading="lazy" /> : <span class="absolute -right-4 -bottom-10 font-display text-[9rem] font-black text-white/70 dark:text-white/10">{post.coverMark}</span>}
			<div class="absolute inset-0 bg-linear-to-t from-sky-ink/35 via-transparent to-white/5"></div><span class="absolute top-4 left-4 rounded-full border-2 border-sky-ink bg-white px-3 py-1 text-[10px] font-black text-sky-ink dark:border-white dark:bg-night dark:text-white">{post.category}</span>
		</div>
		<div class="flex flex-1 flex-col p-6"><div class="flex justify-between text-[10px] font-black tracking-widest text-sky-ink/40 dark:text-white/35"><span>{post.date}</span><span>{post.readingTime}</span></div><h2 class="mt-5 text-2xl leading-snug font-black text-sky-ink dark:text-white">{post.title}</h2><p class="mt-3 text-sm leading-7 text-sky-ink/55 dark:text-white/50">{post.description}</p><div class="mt-4 flex flex-wrap gap-1.5">{post.tags.slice(0, 3).map((tag) => <a href={`/tags/${toTaxonomySlug(tag)}`} class="relative z-30 rounded-full bg-mizu/10 px-2.5 py-1 text-[10px] font-bold text-sky-ink/50 no-underline dark:text-white/45">#{tag}</a>)}</div><a href={`/posts/${post.slug}`} class="mt-auto flex items-center justify-between pt-6 text-xs font-black text-sky-ink no-underline dark:text-mizu"><span>READ STORY</span><span class="grid size-9 place-items-center rounded-full border-2 border-current transition group-hover:rotate-45">↗</span></a></div>
	</article>)}
</div> : <div class="rounded-3xl border-2 border-dashed border-sky-ink/20 py-24 text-center dark:border-white/15"><p class="text-5xl">☁</p><h2 class="mt-5 text-xl font-black">这里暂时还没有文章</h2></div>}
