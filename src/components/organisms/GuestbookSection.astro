---
/**
 * 留言页页头区块（SSR 静态，零水合零 JS）：
 * 卡片：页头（主题色图标 + 标题 / 副标题）+ 可选留言引导列表（primary 软底信息框）。
 * 留言区由页面层按评论配置编排（CommentSection 或 GuestbookHint 占位），
 * 本区块只负责页头与引导内容。
 * 注意：@iconify/svelte 在纯 SSR 路径不渲染图标，本区块内图标一律 astro-icon，
 * Card 原子按 SSR 静态输出使用；布局工具类作用于 Card 根（Svelte 渲染，作用域样式不可达）。
 */
import Card from "@components/atoms/display/Card.svelte";
import PageHeader from "@components/atoms/display/PageHeader.astro";
import { Icon } from "astro-icon/components";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";

interface Props {
	/** 留言引导语（来自 src/data/guestbook.ts）；空数组时不渲染引导区块 */
	guidelines?: readonly string[];
}

const { guidelines = [] } = Astro.props;
---

<Card color="var(--card-bg)" radius="l" class="guestbook-section px-8 py-6">
	<PageHeader
		icon="material-symbols:forum-outline-rounded"
		title={i18n(I18nKey.guestbook)}
		subtitle={i18n(I18nKey.guestbookBanner)}
	/>

	<!-- 留言引导 -->
	{guidelines.length > 0 && (
		<ul class="guestbook-section__guidelines">
			{guidelines.map((line) => (
				<li class="guestbook-section__guideline">
					<Icon
						name="material-symbols:check-circle-rounded"
						class="guestbook-section__check"
						aria-hidden="true"
					/>
					<span>{line}</span>
				</li>
			))}
		</ul>
	)}
</Card>

<style lang="stylus">
/* Card 根由 Svelte 渲染，内边距与间距走 Tailwind 工具类；此处仅修饰本模板内元素 */
.guestbook-section
	&__guidelines
		display: flex
		flex-direction: column
		gap: 0.625rem
		margin: 0
		padding: 1rem 1.25rem
		list-style: none
		border-radius: var(--shape-corner-m)
		background: unquote("color-mix(in oklab, var(--primary) 8%, transparent)")
		border: 1px solid unquote("color-mix(in oklab, var(--primary) 30%, transparent)")

	&__guideline
		display: flex
		align-items: flex-start
		gap: 0.5rem
		color: var(--on-surface)
		font: var(--m3e-type-body-small)
		line-height: 1.625

	&__check
		flex-shrink: 0
		margin-top: 0.1875rem
		width: 1.125rem
		height: 1.125rem
		color: var(--primary)
</style>
