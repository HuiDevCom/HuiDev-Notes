---
/**
 * 赞助页主区块（SSR 静态，零水合零 JS）：
 * 卡片一：页头（主题色图标 + 标题 / 副标题 / 可选 usage 信息框）+ 赞助方式网格；
 * 卡片二：赞助名单（AccentBar 小节头 + 右侧数量，auto-fill 胶囊条目网格）。
 * 注意：@iconify/svelte 在纯 SSR 路径不渲染图标，本区块内图标一律 astro-icon，
 * Card 原子按 SSR 静态输出使用；布局工具类作用于 Card 根（Svelte 渲染，作用域样式不可达）。
 */
import AccentBar from "@components/atoms/display/AccentBar.svelte";
import Card from "@components/atoms/display/Card.svelte";
import PageHeader from "@components/atoms/display/PageHeader.astro";
import SponsorMethodCard from "@components/molecules/SponsorMethodCard.astro";
import SponsorRecordItem from "@components/molecules/SponsorRecordItem.astro";
import { Icon } from "astro-icon/components";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import type { SponsorMethod, SponsorRecord } from "@/types/sponsorConfig";

interface Props {
	methods?: SponsorMethod[];
	records?: SponsorRecord[];
	/** 是否展示赞助名单区块（来自 sponsorConfig.showList） */
	showList?: boolean;
	/** 可选用法/致谢提示（来自 sponsorConfig.usage） */
	usage?: string;
}

const { methods = [], records = [], showList = true, usage } = Astro.props;
---

<Card color="var(--card-bg)" radius="l" class="sponsor-section px-8 py-6">
	<PageHeader
		icon="material-symbols:favorite"
		title={i18n(I18nKey.sponsor)}
		subtitle={i18n(I18nKey.sponsorBanner)}
	/>

	{usage && (
		<div class="sponsor-section__usage">
			<Icon
				name="material-symbols:info-outline"
				class="sponsor-section__usage-icon"
				aria-hidden="true"
			/>
			<p class="sponsor-section__usage-text">{usage}</p>
		</div>
	)}

	<!-- 打赏方式 -->
	<div class="sponsor-section__methods">
		{methods.map((method) => <SponsorMethodCard {method} />)}
	</div>
</Card>

<!-- 赞助名单 -->
{showList && (
	<Card
		color="var(--card-bg)"
		radius="l"
		class="sponsor-section sponsor-section--list px-8 py-6 mt-4"
	>
		<div class="sponsor-section__list-header">
			<div class="sponsor-section__list-title">
				<AccentBar size="small" class="!inline-block" />
				<h2
					class="sponsor-section__list-heading m-0 text-xl font-bold md:text-2xl text-[var(--on-surface)]"
				>
					{i18n(I18nKey.sponsorList)}
				</h2>
			</div>
			{records.length > 0 && (
				<span class="sponsor-section__count">{records.length}</span>
			)}
		</div>

		{records.length > 0 ? (
			<div class="sponsor-section__records">
				{records.map((record) => <SponsorRecordItem {record} />)}
			</div>
		) : (
			<p class="sponsor-section__empty">{i18n(I18nKey.sponsorEmpty)}</p>
		)}
	</Card>
)}

<style lang="stylus">
/* Card 根由 Svelte 渲染，内边距与间距走 Tailwind 工具类；此处仅修饰本模板内元素 */
.sponsor-section
	&__usage
		display: flex
		align-items: flex-start
		gap: 0.5rem
		margin-bottom: 2rem
		padding: 1rem
		border-radius: var(--shape-corner-m)
		background: unquote("color-mix(in oklab, var(--primary) 8%, transparent)")
		border: 1px solid unquote("color-mix(in oklab, var(--primary) 30%, transparent)")

	&__usage-icon
		flex-shrink: 0
		margin-top: 0.125rem
		color: var(--primary)
		width: 1.125rem
		height: 1.125rem

	&__usage-text
		margin: 0
		color: var(--on-surface)
		font: var(--m3e-type-body-small)
		line-height: 1.625

	&__methods
		display: grid
		grid-template-columns: 1fr
		gap: 1.5rem

		@media (min-width: 40rem)
			grid-template-columns: repeat(2, 1fr)

	&__list-header
		display: flex
		align-items: center
		justify-content: space-between
		margin-bottom: 1.5rem

	&__list-title
		display: flex
		align-items: center
		gap: 0.75rem

	&__count
		color: var(--on-surface-variant)
		font: var(--m3e-type-label-small)

	&__records
		display: grid
		grid-template-columns: repeat(auto-fill, minmax(16.25rem, 1fr))
		gap: 0.75rem

	&__empty
		display: flex
		align-items: center
		justify-content: center
		min-height: 6rem
		margin: 0
		color: var(--on-surface-variant)
		font: var(--m3e-type-body-large)
		text-align: center
</style>
