---
/**
 * 评论未启用占位卡：留言数据由评论系统托管，未启用时给出配置引导而非空白区域。
 * 纯 SSR 静态输出，零外部请求零脚本。
 */
import Card from "@components/atoms/display/Card.svelte";
import { Icon } from "astro-icon/components";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<Card
	color="var(--card-bg)"
	radius="l"
	class:list={["guestbook-hint px-8 py-12", className]}
>
	<div class="guestbook-hint__icon">
		<Icon
			name="material-symbols:chat-bubble-outline-rounded"
			aria-hidden="true"
		/>
	</div>
	<p class="guestbook-hint__title">
		{i18n(I18nKey.guestbookCommentsDisabled)}
	</p>
	<p class="guestbook-hint__desc">
		{i18n(I18nKey.guestbookCommentsDisabledHint)}
	</p>
</Card>

<style lang="stylus">
/* Card 根由 Svelte 渲染，内边距与间距走 Tailwind 工具类；此处仅修饰本模板内元素 */
.guestbook-hint
	text-align: center

	&__icon
		display: flex
		align-items: center
		justify-content: center
		width: 3.5rem
		height: 3.5rem
		margin: 0 auto 1rem
		border-radius: var(--shape-corner-full)
		background: unquote("color-mix(in oklab, var(--primary) 10%, transparent)")

		:global(svg)
			width: 1.75rem
			height: 1.75rem
			color: var(--primary)

	&__title
		margin: 0
		color: var(--on-surface)
		font: var(--m3e-type-title-medium)
		font-weight: 700

	&__desc
		margin: 0.5rem 0 0
		color: var(--on-surface-variant)
		font: var(--m3e-type-body-small)
		line-height: 1.625
</style>
