---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import HomePage from '../components/HomePage.svelte';
import { siteConfig } from '@/config';

const dateFormatter = new Intl.DateTimeFormat('sv-SE', {
	year: 'numeric',
	month: '2-digit',
	day: '2-digit',
	timeZone: siteConfig.timeZone,
});

const posts = (await getCollection('posts', ({ data }) => !data.draft))
	.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
	.map((entry) => {
		const date = dateFormatter.format(entry.data.publishedAt);
		return {
			slug: entry.id,
			category: entry.data.category,
			date: date.slice(5).replace('-', '.'),
			title: entry.data.title,
			description: entry.data.description,
			readTime: entry.data.readingTime,
			tone: entry.data.coverTone,
			mark: entry.data.coverMark,
			coverImage: entry.data.coverImage,
		};
	});

const momentDateFormatter = new Intl.DateTimeFormat('en-US', {
	month: 'short',
	day: '2-digit',
	timeZone: siteConfig.timeZone,
});
const momentTimeFormatter = new Intl.DateTimeFormat('zh-CN', {
	hour: '2-digit',
	minute: '2-digit',
	hourCycle: 'h23',
	timeZone: siteConfig.timeZone,
});

const moments = (await getCollection('moments', ({ data }) => !data.draft))
	.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
	.map((entry) => ({
		slug: entry.id,
		date: momentDateFormatter.format(entry.data.publishedAt).toUpperCase().replace(' ', '. '),
		time: momentTimeFormatter.format(entry.data.publishedAt),
		html: entry.rendered?.html ?? entry.body ?? '',
		tag: entry.data.tag,
		icon: entry.data.icon,
		tone: entry.data.tone,
	}));
---

<Layout title={siteConfig.title} description={siteConfig.description}>
	<HomePage {posts} {moments} client:load />
</Layout>
