---
import { getCollection } from 'astro:content';
import CollectionLayout from '@/layouts/CollectionLayout.astro';
import { collectTerms, sortPosts, toTaxonomySlug } from '@/utils/taxonomy';

const posts = sortPosts(await getCollection('posts', ({ data }) => !data.draft));
const categories = collectTerms(posts, (post) => [post.data.category]);
---

<CollectionLayout title="文章分类" description="循着不同主题，找到想读的故事。" eyebrow="STORY SHELVES" activeKey="posts">
	<div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
		{categories.map(([category, items], index) => <a href={`/categories/${toTaxonomySlug(category)}`} class="anime-shadow-sm group relative min-h-56 overflow-hidden rounded-3xl border-2 border-sky-ink bg-white p-7 no-underline transition hover:-translate-y-2 dark:border-white/20 dark:bg-[#181d3a]">
			<span class="absolute -right-3 -bottom-10 font-display text-[9rem] font-black text-mizu/10">{String(index + 1).padStart(2, '0')}</span>
			<p class="text-[10px] font-black tracking-[.22em] text-sakura">CATEGORY</p>
			<h2 class="mt-5 text-3xl font-black text-sky-ink dark:text-white">{category}</h2>
			<p class="mt-3 text-sm text-sky-ink/45 dark:text-white/40">{items.length} 篇文章</p>
			<span class="absolute right-7 bottom-7 grid size-10 place-items-center rounded-full border-2 border-sky-ink text-sky-ink transition group-hover:rotate-45 dark:border-white dark:text-white">↗</span>
		</a>)}
	</div>
</CollectionLayout>
