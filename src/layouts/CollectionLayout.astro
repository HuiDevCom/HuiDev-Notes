---
import type { PageKey } from '../types/navBarConfig';
import Layout from './Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { createPageTitle } from '@/config';

interface Props {
	title: string;
	description: string;
	eyebrow: string;
	count?: string;
	activeKey?: PageKey;
}

const { title, description, eyebrow, count, activeKey = 'posts' } = Astro.props;
---

<Layout title={createPageTitle(title)} description={description}>
	<div id="top" class="relative min-h-screen overflow-hidden bg-[#eef8ff] text-night transition-colors duration-500 dark:bg-night dark:text-white">
		<div aria-hidden="true" class="pointer-events-none fixed inset-0 overflow-hidden"><div class="absolute -left-48 top-20 size-[34rem] rounded-full bg-mizu/15 blur-3xl dark:bg-mizu/8"></div><div class="absolute -right-48 top-[32rem] size-[38rem] rounded-full bg-sakura/10 blur-3xl dark:bg-sakura/8"></div><div class="absolute inset-0 opacity-[.18] dark:opacity-[.06]" style="background-image: linear-gradient(rgba(35,55,99,.13) 1px, transparent 1px), linear-gradient(90deg, rgba(35,55,99,.13) 1px, transparent 1px); background-size: 48px 48px;"></div></div>
		<SiteHeader activeKey={activeKey} />
		<main class="relative z-10 mx-auto max-w-[1440px] px-5 pt-20 pb-28 sm:px-8 lg:px-12 lg:pt-28">
			<header class="flex flex-col gap-7 border-b-2 border-sky-ink/15 pb-12 sm:flex-row sm:items-end sm:justify-between dark:border-white/10">
				<div><a href="/posts" class="mb-8 inline-flex text-xs font-black tracking-widest text-sky-ink/45 no-underline hover:text-sakura dark:text-white/40">← ALL STORIES</a><p class="text-xs font-black tracking-[.28em] text-sakura">{eyebrow}</p><h1 class="mt-3 font-display text-[clamp(3.5rem,8vw,7rem)] leading-none font-black tracking-[-.07em] text-sky-ink dark:text-white">{title}<span class="text-mizu">。</span></h1><p class="mt-5 max-w-2xl text-base leading-8 text-sky-ink/55 dark:text-white/50">{description}</p></div>
				{count && <span class="self-start rounded-full border-2 border-sky-ink bg-yuzu px-5 py-2 text-xs font-black tracking-[.16em] text-sky-ink anime-shadow-sm sm:self-auto dark:border-white">{count}</span>}
			</header>
			<div class="pt-12"><slot /></div>
		</main>
		<SiteFooter />
	</div>
</Layout>
