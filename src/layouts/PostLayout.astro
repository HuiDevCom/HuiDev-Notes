---
import Layout from './Layout.astro';
import TwikooComments from '../components/TwikooComments.astro';
import UmamiStats from '../components/UmamiStats.astro';
import { articleConfig, createPageTitle, enabledNavItems, navBarConfig, siteConfig, umamiConfig } from '@/config';
import { toTaxonomySlug } from '@/utils/taxonomy';

interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface PostLink {
	slug: string;
	title: string;
}

interface RelatedPost {
	slug: string;
	title: string;
	description: string;
	category: string;
	coverImage?: string;
	coverTone: 'sky' | 'sunset' | 'mint';
	readingTime: string;
}

interface Props {
	title: string;
	description: string;
	publishedAt: Date;
	updatedAt?: Date;
	category: string;
	tags: string[];
	readingTime: string;
	coverTone: 'sky' | 'sunset' | 'mint';
	coverMark: string;
	coverImage?: string;
	headings: Heading[];
	toc?: boolean;
	comments?: boolean;
	previous?: PostLink;
	next?: PostLink;
	related?: RelatedPost[];
}

const {
	title,
	description,
	publishedAt,
	updatedAt,
	category,
	tags,
	readingTime,
	coverTone,
	coverMark,
	coverImage,
	headings,
	toc = true,
	comments = true,
	previous,
	next,
	related = [],
} = Astro.props;

const formatDate = (date: Date) => new Intl.DateTimeFormat(articleConfig.date.locale, {
	year: 'numeric', month: 'long', day: 'numeric', timeZone: articleConfig.date.timeZone,
}).format(date);

const toneClasses = {
	sky: 'from-[#b9efff] via-[#e9fbff] to-[#d9d4ff] dark:from-[#1a4053] dark:via-[#182a43] dark:to-[#312a62]',
	sunset: 'from-[#ffe0ed] via-[#fff1f5] to-[#ffe9ba] dark:from-[#4c2643] dark:via-[#3d293f] dark:to-[#4a3824]',
	mint: 'from-[#d5f7e4] via-[#f1ffed] to-[#fff3af] dark:from-[#1e453c] dark:via-[#253d34] dark:to-[#484022]',
};

const tableOfContents = articleConfig.toc.enable && toc
	? headings.filter((heading) => heading.depth <= articleConfig.toc.depth)
	: [];
const showTableOfContents = tableOfContents.length > 0;
---

<Layout title={createPageTitle(title)} description={description}>
	<div class="relative min-h-screen overflow-hidden bg-[#eef8ff] text-night transition-colors duration-500 dark:bg-night dark:text-white">
		{articleConfig.readingProgress.enable && <div class="fixed inset-x-0 top-0 z-[100] h-1 bg-sky-ink/5 dark:bg-white/5" aria-hidden="true"><span data-reading-progress class="block h-full origin-left scale-x-0 bg-linear-to-r from-mizu via-sakura to-yuzu will-change-transform"></span></div>}
		<div aria-hidden="true" class="pointer-events-none fixed inset-0 overflow-hidden">
			<div class="absolute -left-48 top-20 size-[34rem] rounded-full bg-mizu/15 blur-3xl dark:bg-mizu/8"></div>
			<div class="absolute -right-48 top-[40rem] size-[38rem] rounded-full bg-sakura/10 blur-3xl dark:bg-sakura/8"></div>
			<div class="absolute inset-0 opacity-[.16] dark:opacity-[.05]" style="background-image: linear-gradient(rgba(35,55,99,.13) 1px, transparent 1px), linear-gradient(90deg, rgba(35,55,99,.13) 1px, transparent 1px); background-size: 48px 48px;"></div>
		</div>

		<header class="relative z-50 px-4 pt-4 sm:px-6 lg:px-10">
			<div class="mx-auto flex h-17 max-w-[1440px] items-center justify-between rounded-2xl border-2 border-sky-ink/15 bg-white/80 px-4 shadow-[0_10px_40px_rgba(35,55,99,.08)] backdrop-blur-xl sm:px-6 dark:border-white/10 dark:bg-[#171c38]/85">
				<a href="/" class="group flex items-center gap-3 no-underline" aria-label={`${siteConfig.name}首页`}>
					<img src={siteConfig.logo} alt={siteConfig.logoAlt} class="anime-shadow-sm size-10 rotate-[-4deg] rounded-xl border-2 border-sky-ink bg-white object-cover dark:border-white" />
					<span><strong class="block text-base leading-tight tracking-[.16em] text-sky-ink dark:text-white">{siteConfig.name}</strong><small class="block text-[9px] font-bold tracking-[.23em] text-sky-ink/45 dark:text-white/45">{siteConfig.englishName}</small></span>
				</a>
				{navBarConfig.enable && (
					<nav class="hidden items-center gap-1 rounded-full border border-sky-ink/10 bg-white/55 p-1 text-sm font-bold text-sky-ink/65 md:flex dark:border-white/10 dark:bg-white/5 dark:text-white/65" aria-label={navBarConfig.ariaLabel}>
						{enabledNavItems.map((item) => (
							<a href={item.href} target={item.external ? '_blank' : undefined} aria-current={item.key === 'posts' ? 'page' : undefined} class={`rounded-full px-5 py-2 no-underline transition ${item.key === 'posts' ? 'bg-sky-ink text-white shadow-sm dark:bg-mizu dark:text-night' : 'hover:bg-mizu/15'}`}>{item.label}</a>
						))}
					</nav>
				)}
				<button data-theme-toggle class="grid size-10 cursor-pointer place-items-center rounded-full border-2 border-sky-ink/15 bg-white text-lg text-sky-ink transition hover:border-mizu dark:border-white/15 dark:bg-white/5 dark:text-white" aria-label="切换深浅色主题">☾</button>
			</div>
		</header>

		<main class="relative z-10 px-5 sm:px-8 lg:px-12">
			<article data-pagefind-body class="mx-auto max-w-[1180px] pt-16 pb-28 sm:pt-24">
				<header>
					<a href="/posts" class="inline-flex items-center gap-2 text-xs font-black tracking-widest text-sky-ink/45 no-underline transition hover:text-sakura dark:text-white/40">← ALL STORIES</a>
					<div class="mt-10 flex flex-wrap items-center gap-3 text-[11px] font-black tracking-[.16em] text-sky-ink/50 dark:text-white/45">
						<a href={`/categories/${toTaxonomySlug(category)}`} data-pagefind-filter="category" class="rounded-full border-2 border-sky-ink bg-yuzu px-3 py-1.5 text-sky-ink no-underline dark:border-white">{category}</a>
						<span>{formatDate(publishedAt)}</span><span>·</span><span>{readingTime} READ</span>
						{umamiConfig.stats.showOnPosts && <><span>·</span><UmamiStats path={Astro.url.pathname} variant="post" /></>}
					</div>
					<h1 data-pagefind-meta="title" class="mt-7 max-w-5xl font-display text-[clamp(3rem,7vw,6.5rem)] leading-[1.06] font-black tracking-[-.065em] text-sky-ink dark:text-white">{title}</h1>
					<p class="mt-7 max-w-3xl text-lg leading-8 font-medium text-sky-ink/55 sm:text-xl dark:text-white/50">{description}</p>
					<div class="mt-8 flex flex-wrap items-center gap-2">
						{tags.map((tag) => <a href={`/tags/${toTaxonomySlug(tag)}`} data-pagefind-filter="tag" class="rounded-full border border-sky-ink/15 bg-white/60 px-3 py-1.5 text-xs font-bold text-sky-ink/55 no-underline transition hover:border-mizu dark:border-white/10 dark:bg-white/5 dark:text-white/45">#{tag}</a>)}
					</div>
				</header>

				<div class={`anime-shadow relative mt-14 h-64 overflow-hidden rounded-3xl border-2 border-sky-ink bg-linear-to-br sm:h-[28rem] dark:border-white/20 ${toneClasses[coverTone]}`}>
					{coverImage && <img src={coverImage} alt={`${title}封面`} data-pagefind-meta="image[src], image_alt[alt]" class="absolute inset-0 h-full w-full object-cover dark:opacity-80" />}
					<div class="absolute inset-0 bg-linear-to-t from-sky-ink/25 via-transparent to-white/5"></div>
					{!coverImage && <span class="absolute -right-4 -bottom-20 font-display text-[15rem] leading-none font-black text-white/75 sm:text-[25rem] dark:text-white/12">{coverMark}</span>}
					<div class="absolute top-6 left-6 rounded-full border-2 border-sky-ink bg-white px-4 py-2 text-[10px] font-black tracking-[.2em] text-sky-ink dark:border-white dark:bg-night dark:text-white">{articleConfig.cover.label} · {publishedAt.getFullYear()}</div>
				</div>

				<div class={`mt-16 grid gap-12 lg:justify-center ${showTableOfContents ? 'lg:grid-cols-[220px_minmax(0,720px)]' : 'mx-auto max-w-[720px]'}`}>
					{showTableOfContents && <aside class="hidden lg:block">
						<div class="sticky top-8 rounded-2xl border-2 border-sky-ink/10 bg-white/60 p-5 backdrop-blur dark:border-white/10 dark:bg-white/5">
							<p class="text-[10px] font-black tracking-[.22em] text-sakura">ON THIS PAGE</p>
							<nav class="mt-4 flex flex-col gap-3 text-sm font-bold text-sky-ink/50 dark:text-white/45" aria-label="文章目录">
								{tableOfContents.map((heading) => <a href={`#${heading.slug}`} data-toc-link class="leading-6 no-underline transition hover:text-sakura">{heading.text}</a>)}
							</nav>
							<div class="mt-6 border-t border-sky-ink/10 pt-5 text-[11px] leading-6 text-sky-ink/40 dark:border-white/10 dark:text-white/35">
								<p>发布于 {formatDate(publishedAt)}</p>
								{updatedAt && <p>更新于 {formatDate(updatedAt)}</p>}
							</div>
						</div>
					</aside>}

					<div class="post-body min-w-0"><slot /></div>
				</div>

				{articleConfig.share.enable && <section data-pagefind-ignore class="mt-16 flex flex-col gap-5 rounded-3xl border-2 border-sky-ink/10 bg-white/55 p-6 sm:flex-row sm:items-center sm:justify-between dark:border-white/10 dark:bg-white/5">
					<div><p class="text-[10px] font-black tracking-[.2em] text-sakura">PASS THE WIND</p><h2 class="mt-2 text-xl font-black text-sky-ink dark:text-white">把这篇文章分享给同路的人</h2><p data-share-status class="mt-1 min-h-5 text-xs text-sky-ink/40 dark:text-white/35" aria-live="polite"></p></div>
					<div class="flex flex-wrap gap-2">
						{articleConfig.share.copyLink && <button type="button" data-copy-link class="cursor-pointer rounded-full border-2 border-sky-ink bg-white px-5 py-2.5 text-xs font-black text-sky-ink transition hover:-translate-y-0.5 dark:border-white dark:bg-night dark:text-white">复制链接</button>}
						{articleConfig.share.nativeShare && <button type="button" data-native-share class="cursor-pointer rounded-full border-2 border-sky-ink bg-sky-ink px-5 py-2.5 text-xs font-black text-white transition hover:-translate-y-0.5 dark:border-mizu dark:bg-mizu dark:text-night">分享文章 ↗</button>}
					</div>
				</section>}

				{articleConfig.relatedPosts.enable && related.length > 0 && <section data-pagefind-ignore class="mt-20">
					<div class="mb-7 flex items-end justify-between"><div><p class="text-[10px] font-black tracking-[.22em] text-mizu">MORE STORIES</p><h2 class="mt-2 font-display text-3xl font-black text-sky-ink dark:text-white">也许你还会喜欢</h2></div><a href="/posts" class="text-xs font-black text-sky-ink/45 no-underline hover:text-sakura dark:text-white/40">全部文章 →</a></div>
					<div class={`grid gap-5 ${related.length === 1 ? '' : related.length === 2 ? 'md:grid-cols-2' : 'md:grid-cols-3'}`}>
						{related.map((post) => <a href={`/posts/${post.slug}`} class="group overflow-hidden rounded-2xl border-2 border-sky-ink bg-white no-underline anime-shadow-sm transition hover:-translate-y-1 dark:border-white/20 dark:bg-white/5">
							<div class={`relative h-28 bg-linear-to-br ${toneClasses[post.coverTone]}`}>{post.coverImage && <img src={post.coverImage} alt="" class="absolute inset-0 size-full object-cover transition duration-500 group-hover:scale-105" loading="lazy" />}<span class="absolute top-3 left-3 rounded-full bg-white/90 px-2.5 py-1 text-[9px] font-black text-sky-ink">{post.category}</span></div>
							<div class="p-5"><h3 class="line-clamp-2 text-lg leading-7 font-black text-sky-ink dark:text-white">{post.title}</h3><p class="mt-3 line-clamp-2 text-xs leading-6 text-sky-ink/45 dark:text-white/40">{post.description}</p><span class="mt-4 block text-[10px] font-black tracking-wider text-sakura">{post.readingTime} READ →</span></div>
						</a>)}
					</div>
				</section>}

				{articleConfig.previousNext.enable && <nav data-pagefind-ignore class="mt-20 grid gap-5 border-t-2 border-sky-ink/10 pt-10 sm:grid-cols-2 dark:border-white/10" aria-label="相邻文章">
					{previous ? <a href={`/posts/${previous.slug}`} class="group rounded-2xl border-2 border-sky-ink bg-white p-6 no-underline anime-shadow-sm transition hover:-translate-y-1 dark:border-white/20 dark:bg-white/5"><span class="text-[10px] font-black tracking-[.2em] text-sakura">← PREVIOUS</span><strong class="mt-3 block text-lg leading-7 text-sky-ink dark:text-white">{previous.title}</strong></a> : <span></span>}
					{next && <a href={`/posts/${next.slug}`} class="group rounded-2xl border-2 border-sky-ink bg-white p-6 text-right no-underline anime-shadow-sm transition hover:-translate-y-1 dark:border-white/20 dark:bg-white/5"><span class="text-[10px] font-black tracking-[.2em] text-mizu">NEXT →</span><strong class="mt-3 block text-lg leading-7 text-sky-ink dark:text-white">{next.title}</strong></a>}
				</nav>}

				{comments && <div data-pagefind-ignore><TwikooComments /></div>}
			</article>
		</main>

		<footer class="relative z-10 border-t-2 border-sky-ink/10 bg-white/50 px-5 py-10 dark:border-white/10 dark:bg-white/[.025] sm:px-8 lg:px-12">
			<div class="mx-auto flex max-w-[1180px] flex-col gap-6 sm:flex-row sm:items-center sm:justify-between"><div class="flex items-center gap-3"><img src={siteConfig.logo} alt="" class="size-10 rounded-xl border-2 border-sky-ink bg-white object-cover dark:border-white" /><strong class="tracking-[.12em] text-sky-ink dark:text-white">{siteConfig.name}</strong></div><div class="flex flex-wrap items-center gap-5 text-xs text-sky-ink/40 dark:text-white/35"><span>{siteConfig.footer.copyright}</span><a href="/rss.xml" class="font-bold text-sky-ink/55 no-underline hover:text-sakura dark:text-white/50">RSS</a>{umamiConfig.publicShare.enable && umamiConfig.publicShare.url && <a href={umamiConfig.publicShare.url} target="_blank" rel="noopener noreferrer" class="font-bold text-sky-ink/55 no-underline hover:text-mizu dark:text-white/50">{umamiConfig.publicShare.label} ↗</a>}</div></div>
		</footer>
	</div>

	<script is:inline define:vars={{ themeStorageKey: siteConfig.theme.storageKey, shareTitle: title, shareText: description }}>
		const button = document.querySelector('[data-theme-toggle]');
		const syncIcon = () => { if (button) button.textContent = document.documentElement.classList.contains('dark') ? '☀' : '☾'; };
		syncIcon();
		button?.addEventListener('click', () => {
			document.documentElement.classList.toggle('dark');
			localStorage.setItem(themeStorageKey, document.documentElement.classList.contains('dark') ? 'dark' : 'light');
			syncIcon();
		});

		const progress = document.querySelector('[data-reading-progress]');
		const updateProgress = () => {
			if (!progress) return;
			const scrollable = document.documentElement.scrollHeight - window.innerHeight;
			const value = scrollable > 0 ? Math.min(window.scrollY / scrollable, 1) : 0;
			progress.style.transform = `scaleX(${value})`;
		};
		updateProgress();
		window.addEventListener('scroll', updateProgress, { passive: true });
		window.addEventListener('resize', updateProgress);

		const status = document.querySelector('[data-share-status]');
		const showStatus = (message) => { if (status) status.textContent = message; };
		const copyUrl = async () => {
			try { await navigator.clipboard.writeText(window.location.href); showStatus('链接已复制到剪贴板。'); }
			catch { showStatus('复制失败，请从地址栏复制链接。'); }
		};
		document.querySelector('[data-copy-link]')?.addEventListener('click', copyUrl);
		const nativeShare = document.querySelector('[data-native-share]');
		if (nativeShare && !navigator.share) nativeShare.setAttribute('hidden', '');
		nativeShare?.addEventListener('click', async () => {
			try { await navigator.share({ title: shareTitle, text: shareText, url: window.location.href }); showStatus('谢谢你把风传得更远。'); }
			catch (error) { if (error?.name !== 'AbortError') await copyUrl(); }
		});
	</script>
</Layout>

<style is:global>
	.post-body { color: color-mix(in srgb, var(--color-sky-ink) 78%, transparent); font-family: var(--font-display); font-size: 1.08rem; line-height: 2; }
	.dark .post-body { color: rgba(255,255,255,.72); }
	.post-body > :first-child { margin-top: 0; }
	.post-body h2 { margin: 3.8rem 0 1.25rem; color: var(--color-sky-ink); font-family: var(--font-sans); font-size: clamp(1.65rem, 3vw, 2.25rem); font-weight: 900; letter-spacing: -.035em; line-height: 1.3; }
	.dark .post-body h2 { color: #fff; }
	.post-body h3 { margin: 2.8rem 0 1rem; color: var(--color-sky-ink); font-family: var(--font-sans); font-size: 1.4rem; font-weight: 900; }
	.dark .post-body h3 { color: #fff; }
	.post-body p { margin: 1.35rem 0; }
	.post-body strong { color: var(--color-sky-ink); font-weight: 800; }
	.dark .post-body strong { color: var(--color-mizu); }
	.post-body a { color: #1688ab; font-weight: 700; text-decoration-thickness: 1px; text-underline-offset: 4px; }
	.post-body ul, .post-body ol { margin: 1.5rem 0; padding-left: 1.5rem; }
	.post-body li { margin: .65rem 0; padding-left: .35rem; }
	.post-body li::marker { color: var(--color-sakura); font-weight: 900; }
	.post-body blockquote { position: relative; margin: 2.5rem 0; padding: 1.5rem 1.75rem 1.5rem 2rem; border: 2px solid var(--color-sky-ink); border-radius: 1rem; background: rgba(255,214,110,.25); color: var(--color-sky-ink); font-size: 1.1em; font-weight: 700; box-shadow: 5px 5px 0 rgba(35,55,99,.85); }
	.dark .post-body blockquote { border-color: rgba(255,255,255,.3); background: rgba(255,214,110,.08); color: #fff; box-shadow: 5px 5px 0 rgba(72,199,232,.22); }
	.post-body blockquote p { margin: 0; }
	.post-body code { border-radius: .35rem; background: rgba(72,199,232,.14); padding: .16rem .4rem; color: #176781; font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: .9em; }
	.dark .post-body code { color: #87e4fb; }
	.post-body pre { margin: 2rem 0; overflow-x: auto; border: 2px solid var(--color-sky-ink); border-radius: 1rem; background: #151a34 !important; padding: 1.4rem; box-shadow: 5px 5px 0 rgba(35,55,99,.85); }
	.post-body pre code { background: transparent; padding: 0; color: inherit; font-size: .9rem; line-height: 1.75; }
	.post-body hr { margin: 3rem 0; border: 0; border-top: 2px solid rgba(35,55,99,.12); }
	@media (max-width: 640px) { .post-body { font-size: 1rem; line-height: 1.9; } .post-body blockquote { padding: 1.25rem; } }
</style>
