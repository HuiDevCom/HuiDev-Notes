# 站点正式域名（用于 canonical 与社交分享元数据）
PUBLIC_SITE_URL=https://huidev.com/

# Twikoo 评论系统
# 腾讯云填写环境 ID；Vercel / 私有部署填写后端地址。
PUBLIC_TWIKOO_ENV_ID=https://twikoo.huidev.com/
# 腾讯云非上海地域时填写，例如 ap-guangzhou；Vercel / 私有部署留空。
PUBLIC_TWIKOO_REGION=
PUBLIC_TWIKOO_CDN_URL=https://cdn.jsdelivr.net/npm/twikoo@1.7.22/dist/twikoo.min.js

# Umami 访问统计
PUBLIC_UMAMI_WEBSITE_ID=6c5ecfdf-dee0-4867-8f62-851be88239e4
# Umami Cloud 使用下面的默认地址；自托管时改成实例的 /script.js 地址。
PUBLIC_UMAMI_SCRIPT_URL=https://umami.huidev.com/script.js
# 仅当统计接收地址与脚本地址不同时填写。
PUBLIC_UMAMI_HOST_URL=
# 可选：只统计指定域名，多个域名用英文逗号分隔。
PUBLIC_UMAMI_DOMAINS=
# 可选：公开统计页面，用于将来在站内展示统计入口。
PUBLIC_UMAMI_SHARE_URL=https://umami.huidev.com/share/uMHtGWTow6pWGeo3
